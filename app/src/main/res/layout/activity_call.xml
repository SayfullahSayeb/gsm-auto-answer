<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_gradient">

    <LinearLayout
        android:id="@+id/call_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/phase_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/incoming_call"
            android:textColor="@color/call_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/caller_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/call_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/caller_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/call_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/call_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/call_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="center_horizontal">

            <View
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_call_disc" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/countdown_progress"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:max="1000"
                android:progress="1000"
                android:visibility="gone"
                app:indicatorColor="@color/unmute_green"
                app:indicatorSize="196dp"
                app:trackColor="#2A3F3E"
                app:trackThickness="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/visual_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/call_text" />

                <ProgressBar
                    android:id="@+id/prepare_spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="10dp"
                    android:indeterminateTint="@color/unmute_green"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/countdown_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/call_text"
                    android:textSize="62sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/countdown_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/countdown_seconds_label"
                    android:textColor="@color/call_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/call_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/call_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/route_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_call_chip"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="@color/unmute_green"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/blocked_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_call_warning_card"
            android:lineSpacingMultiplier="1.25"
            android:padding="14dp"
            android:textColor="@color/call_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_call_error_card"
            android:lineSpacingMultiplier="1.25"
            android:padding="14dp"
            android:textColor="@color/call_text"
            android:textSize="14sp"
            android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_unmute"
            style="@style/Theme.GsmAutoAnswer.Call.Button.Unmute"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="@string/unmute"
            android:visibility="gone"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <LinearLayout
            android:id="@+id/ringing_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_decline"
                style="@style/Theme.GsmAutoAnswer.Call.Button.Decline"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/decline"
                app:icon="@drawable/ic_call_end"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_answer"
                style="@style/Theme.GsmAutoAnswer.Call.Button.Answer"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/answer"
                app:icon="@drawable/ic_phone"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_end"
            style="@style/Theme.GsmAutoAnswer.Call.Button.End"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/end_call"
            android:visibility="gone"
            app:icon="@drawable/ic_call_end"
            app:iconGravity="textStart"
            app:iconPadding="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/close"
            android:textColor="@color/call_text_secondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/idle_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/call_screen_waiting"
            android:textColor="@color/call_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
