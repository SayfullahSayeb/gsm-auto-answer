<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GsmAutoAnswer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/on_brand_container</item>
        <item name="colorTertiary">@color/brand_primary</item>
        <item name="colorTertiaryContainer">@color/brand_container</item>
        <item name="colorOnTertiaryContainer">@color/on_brand_container</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/chip_bg</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorSurfaceContainerLow">@color/card_bg</item>
        <item name="colorSurfaceContainer">@color/card_bg</item>
        <item name="colorSurfaceContainerHigh">@color/card_bg</item>
        <item name="colorSurfaceContainerHighest">@color/chip_bg</item>
        <item name="colorOutline">@color/card_stroke</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/status_bad</item>
        <item name="colorErrorContainer">@color/status_bad_bg</item>
        <item name="android:colorBackground">@color/screen_bg</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:navigationBarColor">@color/card_bg</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.GsmAutoAnswer.Call" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/call_bg</item>
        <item name="android:statusBarColor">@color/call_bg</item>
        <item name="android:navigationBarColor">@color/call_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">@color/unmute_green</item>
        <item name="colorOnPrimary">@color/on_unmute_green</item>
        <item name="colorError">@color/end_red</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.GsmAutoAnswer.Call.Button.Unmute" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/unmute_green</item>
        <item name="android:textColor">@color/on_unmute_green</item>
        <item name="iconTint">@color/on_unmute_green</item>
        <item name="cornerRadius">32dp</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <style name="Theme.GsmAutoAnswer.Call.Button.End" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/end_red</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="iconTint">#FFFFFF</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Theme.GsmAutoAnswer.Call.Button.Answer" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/unmute_green</item>
        <item name="android:textColor">@color/on_unmute_green</item>
        <item name="iconTint">@color/on_unmute_green</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Theme.GsmAutoAnswer.Call.Button.Decline" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/end_red</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="iconTint">#FFFFFF</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.GsmAutoAnswer.DialKey" parent="Widget.Material3.Button">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="backgroundTint">@color/card_bg</item>
        <item name="cornerRadius">32dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.GsmAutoAnswer.SectionLabel" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.GsmAutoAnswer.NavActive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GsmAutoAnswer.NavInactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.GsmAutoAnswer.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.GsmAutoAnswer.GroupCard" parent="Widget.GsmAutoAnswer.Card" />

    <style name="Widget.GsmAutoAnswer.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/brand_container</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="iconTint">@color/brand_primary</item>
    </style>

    <style name="Widget.GsmAutoAnswer.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="iconTint">@color/brand_primary</item>
    </style>
</resources>
